<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_app.Pages.TechnicianJobListPage">
    <StackLayout>
        <Label Text="Technician Jobs" FontSize="24" HorizontalOptions="Center" />
        <CollectionView x:Name="JobListView" SelectionMode="Single" SelectionChanged="OnJobSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding Product.Name}" FontAttributes="Bold" />
                        <Label Text="{Binding Status}" />
                        <Label Text="SLA: {Binding SLAStatus}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
